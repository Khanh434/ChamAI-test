{
  "version": 2,
  "framework": null,
  "outputDirectory": "web",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/opencv/opencv.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/opencv/opencv.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ]
}
